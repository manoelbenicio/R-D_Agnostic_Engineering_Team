[Unit]
Description=Multica credential-isolated daemon on ORQ2
After=multica-orq1-backend-tunnel.service
Requires=multica-orq1-backend-tunnel.service

[Service]
Type=simple
Environment=PATH=/home/ec2-user/.local/bin:/home/ec2-user/.nvm/versions/node/v22.23.1/bin:/home/ec2-user/bin:/usr/local/bin:/usr/bin:/bin
Environment=MULTICA_CODEX_PATH=/home/ec2-user/.nvm/versions/node/v22.23.1/bin/codex
Environment=MULTICA_KIRO_PATH=/home/ec2-user/.local/bin/kiro-cli
Environment=MULTICA_ANTIGRAVITY_PATH=/home/ec2-user/.local/bin/agy
Environment=MULTICA_CLAUDE_PATH=/run/multica-disabled/claude
Environment=MULTICA_OPENCODE_PATH=/run/multica-disabled/opencode
Environment=MULTICA_CLINE_PATH=/run/multica-disabled/cline
Environment=MULTICA_CODEBUDDY_PATH=/run/multica-disabled/codebuddy
Environment=MULTICA_OPENCLAW_PATH=/run/multica-disabled/openclaw
Environment=MULTICA_HERMES_PATH=/run/multica-disabled/hermes
Environment=MULTICA_GEMINI_PATH=/run/multica-disabled/gemini
Environment=MULTICA_PI_PATH=/run/multica-disabled/pi
Environment=MULTICA_CURSOR_PATH=/run/multica-disabled/cursor
Environment=MULTICA_COPILOT_PATH=/run/multica-disabled/copilot
Environment=MULTICA_KIMI_PATH=/run/multica-disabled/kimi
Environment=MULTICA_QODER_PATH=/run/multica-disabled/qoder
Environment=MULTICA_CREDENTIAL_SLOTS_ROOT=/home/ec2-user/.agent-cred-homes/slots
Environment=MULTICA_CREDENTIAL_SLOT_ALLOWLIST_ANTIGRAVITY=162,163,168,169
Environment=MULTICA_CREDENTIAL_SLOT_ALLOWLIST_KIRO=139,140,143,149
Environment=MULTICA_CREDENTIAL_SLOT_ALLOWLIST_CODEX=152,170
UnsetEnvironment=AGENT_BRAIN_DEVELOPMENT_ENABLED
UnsetEnvironment=AGENT_BRAIN_GATEWAY_REQUIRED
UnsetEnvironment=AGENT_BRAIN_ROUTE_MODEL
UnsetEnvironment=AGENT_BRAIN_GATEWAY_BASE_URL
UnsetEnvironment=AGENT_BRAIN_GATEWAY_READINESS_POLICY
UnsetEnvironment=AGENT_BRAIN_GATEWAY_SECRET_FILE
UnsetEnvironment=AGENT_BRAIN_LEGACY_EXECUTION_ENABLED
WorkingDirectory=/home/ec2-user/workspace/R-D_Agnostic_Engineering_Team
ExecStart=/home/ec2-user/.local/lib/multica/bin/multica-auth-credential-home-v1 daemon start --foreground --no-auto-update --server-url http://127.0.0.1:18080 --daemon-id orq2-credential-runtime-v1 --device-name "ORQ2 Credential Runtime"
Restart=on-failure
RestartSec=3
TimeoutStopSec=45

[Install]
WantedBy=default.target
